# Copie para .env apenas para uso LOCAL (executar scripts/auth-*.mjs na sua máquina).
# Em produção (GitHub Actions) estes valores devem ser GitHub Secrets, nunca commitados.

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=

# Opcional: usado por scripts/new-draft.mjs se você quiser gerar texto com Claude
ANTHROPIC_API_KEY=
